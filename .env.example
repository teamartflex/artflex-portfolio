# Copy to .env.local and fill in. Enquiries from the website are emailed to CONTACT_TO.
# SMTP_PASS is a Gmail *app password* (Google Account > Security > 2-Step Verification > App passwords),
# not the normal account password.
SMTP_USER=team.artflex@gmail.com
SMTP_PASS=
CONTACT_TO=team.artflex@gmail.com

# Set to 1 to log submissions instead of sending them (useful for testing)
CONTACT_DRY_RUN=
